# Copy to .env and fill in from Firebase console → Project settings → Your apps → Web app.
# These values are public identifiers and safe to ship in the app bundle.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Set to "true" to use the local Firebase emulators (firebase emulators:start).
EXPO_PUBLIC_USE_EMULATORS=false
# LAN IP of the machine running the emulators (a physical device can't reach localhost).
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1
